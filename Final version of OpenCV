
"""
10-question, two-column Scantron reader.

Features:
- Automatic paper-corner detection
- Perspective correction
- Automatic rotation detection
- Bubble detection
- Answer classification
- REVIEW detection
"""

import argparse
import csv
from pathlib import Path

import cv2
import numpy as np


LETTERS = "ABCDE"
N_QUESTIONS = 10
OPTIONS = 5

WORK_WIDTH = 495

# Standard letter paper dimensions.
PAGE_WIDTH = 850
PAGE_HEIGHT = 1100

# Bubble classification settings.
MAX_SHADED_STD = 27.0
MIN_DARKER_THAN_OTHERS = 12.0

REVIEW_STD = 42.0
REVIEW_DARKNESS = 20.0

SECOND_MARK_STD = 38.0
SECOND_MARK_DARKNESS = 18.0


# --------------------------------------------------
# PAPER DETECTION
# --------------------------------------------------

def order_points(points):
    """Order corners: top-left, top-right, bottom-right, bottom-left."""

    points = np.array(points, dtype="float32")

    ordered = np.zeros((4, 2), dtype="float32")

    sums = points.sum(axis=1)
    differences = np.diff(points, axis=1).flatten()

    ordered[0] = points[np.argmin(sums)]
    ordered[2] = points[np.argmax(sums)]
    ordered[1] = points[np.argmin(differences)]
    ordered[3] = points[np.argmax(differences)]

    return ordered


def find_paper_corners(img):
    """Find the four corners of the paper."""

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    blur = cv2.GaussianBlur(gray, (5, 5), 0)

    # First attempt: separate the bright paper from the darker background.
    _, threshold = cv2.threshold(
        blur,
        0,
        255,
        cv2.THRESH_BINARY + cv2.THRESH_OTSU
    )

    kernel = np.ones((5, 5), np.uint8)

    threshold = cv2.morphologyEx(
        threshold,
        cv2.MORPH_CLOSE,
        kernel,
        iterations=2
    )

    contours, _ = cv2.findContours(
        threshold,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    image_area = img.shape[0] * img.shape[1]

    contours = sorted(
        contours,
        key=cv2.contourArea,
        reverse=True
    )

    # Try to find a large four-corner contour.
    for contour in contours:

        area = cv2.contourArea(contour)

        if area < image_area * 0.15:
            continue

        perimeter = cv2.arcLength(contour, True)

        for epsilon in (0.01, 0.015, 0.02, 0.03, 0.04):

            approx = cv2.approxPolyDP(
                contour,
                epsilon * perimeter,
                True
            )

            if (
                len(approx) == 4
                and cv2.isContourConvex(approx)
            ):
                return order_points(approx.reshape(4, 2))

    # Second attempt: use edge detection if thresholding failed.
    edges = cv2.Canny(blur, 30, 100)

    edges = cv2.morphologyEx(
        edges,
        cv2.MORPH_CLOSE,
        kernel,
        iterations=2
    )

    contours, _ = cv2.findContours(
        edges,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    contours = sorted(
        contours,
        key=cv2.contourArea,
        reverse=True
    )

    for contour in contours:

        area = cv2.contourArea(contour)

        if area < image_area * 0.15:
            continue

        perimeter = cv2.arcLength(contour, True)

        for epsilon in (0.015, 0.02, 0.03, 0.04, 0.05):

            approx = cv2.approxPolyDP(
                contour,
                epsilon * perimeter,
                True
            )

            if (
                len(approx) == 4
                and cv2.isContourConvex(approx)
            ):
                return order_points(approx.reshape(4, 2))

    raise ValueError(
        "Could not detect the four paper corners. "
        "Make sure the entire paper is visible."
    )


# --------------------------------------------------
# PERSPECTIVE CORRECTION
# --------------------------------------------------

def correct_perspective(img):
    """Straighten the paper while preserving its proportions."""

    corners = find_paper_corners(img)

    top_left, top_right, bottom_right, bottom_left = corners

    # Measure the four sides.
    width_top = np.linalg.norm(top_right - top_left)
    width_bottom = np.linalg.norm(bottom_right - bottom_left)

    height_left = np.linalg.norm(bottom_left - top_left)
    height_right = np.linalg.norm(bottom_right - top_right)

    paper_width = max(width_top, width_bottom)
    paper_height = max(height_left, height_right)

    # Determine whether the photographed sheet is landscape or portrait.
    if paper_width >= paper_height:

        output_width = PAGE_HEIGHT
        output_height = PAGE_WIDTH

    else:

        output_width = PAGE_WIDTH
        output_height = PAGE_HEIGHT

    destination = np.array([
        [0, 0],
        [output_width - 1, 0],
        [output_width - 1, output_height - 1],
        [0, output_height - 1]
    ], dtype="float32")

    matrix = cv2.getPerspectiveTransform(
        corners,
        destination
    )

    corrected = cv2.warpPerspective(
        img,
        matrix,
        (output_width, output_height)
    )

    return corrected


# --------------------------------------------------
# RESIZE IMAGE
# --------------------------------------------------

def resize_page(img):

    height = round(
        img.shape[0] * WORK_WIDTH / img.shape[1]
    )

    return cv2.resize(
        img,
        (WORK_WIDTH, height),
        interpolation=cv2.INTER_AREA
    )


# --------------------------------------------------
# ROTATION DETECTION
# --------------------------------------------------

def find_correct_orientation(img):
    """
    Test four rotations and select the orientation
    in which the expected 50-bubble layout is detected.
    """

    rotations = [
        ("0 degrees", img),
        (
            "90 degrees clockwise",
            cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)
        ),
        (
            "180 degrees",
            cv2.rotate(img, cv2.ROTATE_180)
        ),
        (
            "90 degrees counterclockwise",
            cv2.rotate(img, cv2.ROTATE_90_COUNTERCLOCKWISE)
        )
    ]

    errors = []

    for label, rotated in rotations:

        candidate = resize_page(rotated)

        gray = cv2.cvtColor(
            candidate,
            cv2.COLOR_BGR2GRAY
        )

        try:

            rows = find_grid(gray)

            print("Detected page orientation:", label)

            return candidate, gray, rows

        except ValueError as exc:

            errors.append(f"{label}: {exc}")

    raise ValueError(
        "Could not find the 50 bubbles in any orientation.\n"
        + "\n".join(errors)
    )


# --------------------------------------------------
# BUBBLE DETECTION
# --------------------------------------------------

def find_grid(gray):
    """
    Return ten rows:
    Q1-Q5 in the left column,
    Q6-Q10 in the right column.
    """

    blur = cv2.GaussianBlur(
        gray,
        (5, 5),
        1
    )

    found = cv2.HoughCircles(
        blur,
        cv2.HOUGH_GRADIENT,
        dp=1,
        minDist=20,
        param1=100,
        param2=20,
        minRadius=7,
        maxRadius=14
    )

    count = 0 if found is None else len(found[0])

    if count != N_QUESTIONS * OPTIONS:
        raise ValueError(
            f"Found {count} circles instead of 50."
        )

    circles = sorted(
        found[0].tolist(),
        key=lambda c: c[0]
    )

    columns = [
        circles[:25],
        circles[25:]
    ]

    if max(c[0] for c in columns[0]) >= min(c[0] for c in columns[1]):
        raise ValueError(
            "Unable to separate the two answer columns."
        )

    rows = []

    for column in columns:

        column.sort(key=lambda c: c[1])

        for j in range(0, 25, OPTIONS):

            row = sorted(
                column[j:j + OPTIONS],
                key=lambda c: c[0]
            )

            if len(row) != OPTIONS:
                raise ValueError(
                    "Missing bubbles in a question row."
                )

            ys = [c[1] for c in row]

            gaps = np.diff([
                c[0] for c in row
            ])

            if max(ys) - min(ys) > 13:
                raise ValueError(
                    "Bubbles in a question are not horizontally aligned."
                )

            if np.any(gaps < 20) or np.any(gaps > 40):
                raise ValueError(
                    "Unexpected spacing between A-E bubbles."
                )

            rows.append(row)

    # Check the five rows in each column.
    for offset in (0, 5):

        centers = [
            float(np.median([c[1] for c in row]))
            for row in rows[offset:offset + 5]
        ]

        row_gaps = np.diff(centers)

        if np.any(row_gaps < 55) or np.any(row_gaps > 95):
            raise ValueError(
                "Unexpected spacing between question rows."
            )

    # Check alignment between the two columns.
    for i in range(5):

        left_y = np.median([
            c[1] for c in rows[i]
        ])

        right_y = np.median([
            c[1] for c in rows[i + 5]
        ])

        if abs(left_y - right_y) > 15:
            raise ValueError(
                "Question rows across columns do not line up."
            )

    return rows


# --------------------------------------------------
# BUBBLE MEASUREMENT
# --------------------------------------------------

def measure(gray, circle):
    """Measure the central shading of a bubble."""

    x, y, _ = (
        int(round(value))
        for value in circle
    )

    radius = 7

    patch = gray[
        y-radius:y+radius+1,
        x-radius:x+radius+1
    ]

    if patch.shape != (15, 15):
        raise ValueError(
            "Bubble too close to photo edge."
        )

    yy, xx = np.ogrid[
        -radius:radius+1,
        -radius:radius+1
    ]

    pixels = patch[
        xx * xx + yy * yy < 40
    ]

    return (
        float(np.std(pixels)),
        float(np.median(pixels))
    )


# --------------------------------------------------
# ANSWER CLASSIFICATION
# --------------------------------------------------

def classify_question(stats):

    stds = [s for s, _ in stats]
    medians = [m for _, m in stats]

    baseline = float(np.median(medians))

    strong = []

    for i in range(OPTIONS):

        others = [
            medians[j]
            for j in range(OPTIONS)
            if j != i
        ]

        if (
            stds[i] < MAX_SHADED_STD
            and np.median(others) - medians[i]
            >= MIN_DARKER_THAN_OTHERS
        ):
            strong.append(i)

    possible = [
        i for i in range(OPTIONS)
        if i not in strong
        and stds[i] < SECOND_MARK_STD
        and baseline - medians[i] >= SECOND_MARK_DARKNESS
    ]

    if len(strong) >= 2:

        answer = "MULTIPLE"

    elif len(strong) == 1:

        answer = "REVIEW" if possible else LETTERS[strong[0]]

    elif len(possible) >= 2:

        answer = "REVIEW"

    elif len(possible) == 1:

        answer = "REVIEW"

    else:

        darkest = int(np.argmin(medians))

        others = [
            medians[j]
            for j in range(OPTIONS)
            if j != darkest
        ]

        delta = float(
            np.median(others) - medians[darkest]
        )

        answer = (
            "REVIEW"
            if delta >= REVIEW_DARKNESS
            and stds[darkest] < REVIEW_STD
            else "BLANK"
        )

    return answer, strong, possible


# --------------------------------------------------
# MAIN DETECTION FUNCTION
# --------------------------------------------------

def detect_answers(path, debug_path="debug_output_photo.png"):

    img = cv2.imread(str(path))

    if img is None:
        raise ValueError(
            f"Could not open image: {path}"
        )

    # STEP 1: Detect the paper and straighten it.
    corrected = correct_perspective(img)

    # STEP 2: Find the correct page orientation.
    img, gray, rows = find_correct_orientation(corrected)

    # STEP 3: Prepare debug image.
    annotated = img.copy()

    answers = []

    print("Question | Answer   | Std deviations      | Medians")
    print("-" * 76)

    # STEP 4: Read each question.
    for q, row in enumerate(rows, start=1):

        stats = [
            measure(gray, circle)
            for circle in row
        ]

        answer, strong, possible = classify_question(stats)

        answers.append(answer)

        for i, (x, y, _) in enumerate(row):

            # Green = clear mark.
            # Orange = possible mark.
            # Blue = unmarked.

            color = (
                (0, 190, 0) if i in strong
                else (0, 165, 255) if i in possible
                else (255, 0, 0)
            )

            cv2.circle(
                annotated,
                (round(x), round(y)),
                13,
                color,
                2
            )

        x, y, _ = row[0]

        cv2.putText(
            annotated,
            f"{q}:{answer}",
            (max(0, int(x) - 55), max(12, int(y) - 16)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.34,
            (0, 0, 210),
            1
        )

        stds = [
            round(s) for s, _ in stats
        ]

        medians = [
            round(m) for _, m in stats
        ]

        print(
            f"Q{q:02d}      | {answer:<8} | "
            f"{str(stds):<19} | {medians}"
        )

    # STEP 5: Save debug image.
    if not cv2.imwrite(str(debug_path), annotated):
        raise ValueError(
            f"Could not save debug image: {debug_path}"
        )

    print("\nANSWERS:", answers)
    print("Debug image:", debug_path)

    return answers


# --------------------------------------------------
# MANUAL ANSWER CORRECTIONS
# --------------------------------------------------

def apply_corrections(answers, entries, label):

    updated = answers.copy()
    used = set()

    for entry in entries:

        try:

            question_text, answer = entry.split("=", 1)
            question = int(question_text)

        except ValueError as exc:

            raise ValueError(
                f"Invalid {label} correction '{entry}'; use 3=B."
            ) from exc

        answer = answer.strip().upper()

        if question not in range(1, N_QUESTIONS + 1) or question in used:

            raise ValueError(
                f"Invalid or repeated question number: {question}"
            )

        allowed = (
            set(LETTERS)
            if label == "key"
            else set(LETTERS) | {"BLANK", "MULTIPLE"}
        )

        if answer not in allowed:

            raise ValueError(
                f"Invalid {label} answer '{answer}'. "
                f"Allowed: {sorted(allowed)}"
            )

        used.add(question)
        updated[question - 1] = answer

        print(
            f"Manual correction ({label}): "
            f"Q{question} = {answer}"
        )

    return updated


# --------------------------------------------------
# COMMAND-LINE TESTING
# --------------------------------------------------

def main():

    parser = argparse.ArgumentParser(
        description=__doc__
    )

    parser.add_argument(
        "photo",
        help="Photo of the student Scantron"
    )

    parser.add_argument(
        "--key",
        help="Photo of teacher answer key"
    )

    parser.add_argument(
        "--student-id",
        default="test-student"
    )

    parser.add_argument(
        "--csv",
        default="results.csv"
    )

    parser.add_argument(
        "--set",
        action="append",
        default=[],
        metavar="Q=ANSWER"
    )

    parser.add_argument(
        "--key-set",
        action="append",
        default=[],
        metavar="Q=ANSWER"
    )

    args = parser.parse_args()

    try:

        if args.key_set and not args.key:
            raise ValueError(
                "--key-set requires --key"
            )

        student = detect_answers(args.photo)

        student = apply_corrections(
            student,
            args.set,
            "student"
        )

        if not args.key:

            if args.set:
                print("Corrected answers:", student)

            return

        key = detect_answers(
            args.key,
            "debug_key_photo.png"
        )

        key = apply_corrections(
            key,
            args.key_set,
            "key"
        )

        if any(answer not in LETTERS for answer in key):

            raise ValueError(
                "Teacher key has BLANK/MULTIPLE/REVIEW; "
                "correct with --key-set Q=A"
            )

        if "REVIEW" in student:

            questions = [
                str(i)
                for i, answer in enumerate(student, 1)
                if answer == "REVIEW"
            ]

            raise ValueError(
                "Student answer(s) need manual review: Q"
                + ", Q".join(questions)
                + ". Correct with --set Q=A or --set Q=BLANK"
            )

        correct = sum(
            s == k
            for s, k in zip(student, key)
        )

        percent = correct * 100 / N_QUESTIONS

        print(
            f"\nGrade: {correct}/{N_QUESTIONS} "
            f"({percent:.0f}%)"
        )

        output = Path(args.csv)

        output.parent.mkdir(
            parents=True,
            exist_ok=True
        )

        with output.open(
            "a",
            newline="",
            encoding="utf-8"
        ) as file:

            writer = csv.writer(file)

            if file.tell() == 0:

                writer.writerow([
                    "Student ID",
                    *[f"Q{i}" for i in range(1, 11)],
                    "Correct",
                    "Percent"
                ])

            student_id = str(args.student_id)

            if student_id.startswith(
                ("=", "+", "-", "@", "\t", "\r")
            ):
                student_id = "'" + student_id

            writer.writerow([
                student_id,
                *student,
                correct,
                percent
            ])

        print("Saved:", output)

    except (ValueError, OSError, cv2.error) as exc:

        parser.exit(
            1,
            f"ERROR: {exc}\n"
        )


if __name__ == "__main__":
    main()
