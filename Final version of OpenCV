
"""
10-question, two-column Scantron reader.

Features:
- Automatic paper-corner detection
- Perspective correction for angled photographs
- Bubble detection using OpenCV
- Answer classification and REVIEW detection
- Debug image generation
"""

import argparse
import csv
from pathlib import Path

import cv2
import numpy as np


LETTERS = "ABCDE"
N_QUESTIONS = 10
OPTIONS = 5

WORK_WIDTH = 495

# Standard letter-sized paper: 8.5 x 11 inches.
PAGE_WIDTH = 850
PAGE_HEIGHT = 1100

# Bubble classification settings
MAX_SHADED_STD = 27.0
MIN_DARKER_THAN_OTHERS = 12.0

REVIEW_STD = 42.0
REVIEW_DARKNESS = 20.0

SECOND_MARK_STD = 38.0
SECOND_MARK_DARKNESS = 18.0


# --------------------------------------------------
# PERSPECTIVE CORRECTION
# --------------------------------------------------

def order_points(points):
    """
    Arrange four paper corners in this order:
    top-left, top-right, bottom-right, bottom-left.
    """

    points = np.array(points, dtype="float32")

    ordered = np.zeros((4, 2), dtype="float32")

    sums = points.sum(axis=1)
    differences = np.diff(points, axis=1).flatten()

    ordered[0] = points[np.argmin(sums)]          # Top-left
    ordered[2] = points[np.argmax(sums)]          # Bottom-right
    ordered[1] = points[np.argmin(differences)]   # Top-right
    ordered[3] = points[np.argmax(differences)]   # Bottom-left

    return ordered


def find_paper_corners(img):
    """
    Find the four outer corners of the answer sheet.
    """

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # Smooth the image to reduce noise.
    blur = cv2.GaussianBlur(gray, (5, 5), 0)

    # Detect strong edges.
    edges = cv2.Canny(blur, 30, 100)

    # Connect nearby edge segments.
    kernel = np.ones((5, 5), np.uint8)

    edges = cv2.morphologyEx(
        edges,
        cv2.MORPH_CLOSE,
        kernel,
        iterations=2
    )

    contours, _ = cv2.findContours(
        edges,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    if not contours:
        raise ValueError(
            "Could not detect the paper. Make sure all four corners are visible."
        )

    image_area = img.shape[0] * img.shape[1]

    # Sort contours from largest to smallest.
    contours = sorted(
        contours,
        key=cv2.contourArea,
        reverse=True
    )

    for contour in contours:

        area = cv2.contourArea(contour)

        # Ignore objects that are too small to be the paper.
        if area < image_area * 0.15:
            continue

        perimeter = cv2.arcLength(contour, True)

        # Try several approximation levels.
        for epsilon in (0.015, 0.02, 0.03, 0.04, 0.05):

            approx = cv2.approxPolyDP(
                contour,
                epsilon * perimeter,
                True
            )

            if len(approx) == 4 and cv2.isContourConvex(approx):

                corners = approx.reshape(4, 2)

                return order_points(corners)

    raise ValueError(
        "Could not identify all four paper corners. "
        "Try taking a clearer photograph with the entire sheet visible."
    )


def correct_perspective(img):
    """
    Straighten an angled photograph of the answer sheet.
    """

    corners = find_paper_corners(img)

    # Destination coordinates for a straightened sheet.
    destination = np.array([
        [0, 0],
        [PAGE_WIDTH - 1, 0],
        [PAGE_WIDTH - 1, PAGE_HEIGHT - 1],
        [0, PAGE_HEIGHT - 1]
    ], dtype="float32")

    # Calculate the perspective transformation.
    matrix = cv2.getPerspectiveTransform(
        corners,
        destination
    )

    # Apply the transformation.
    corrected = cv2.warpPerspective(
        img,
        matrix,
        (PAGE_WIDTH, PAGE_HEIGHT)
    )

    return corrected


# --------------------------------------------------
# BUBBLE DETECTION
# --------------------------------------------------

def find_grid(gray):
    """
    Return ten rows (Q1-Q5 left, Q6-Q10 right),
    each containing five circles.
    """

    blur = cv2.GaussianBlur(gray, (5, 5), 1)

    found = cv2.HoughCircles(
        blur,
        cv2.HOUGH_GRADIENT,
        dp=1,
        minDist=20,
        param1=100,
        param2=20,
        minRadius=7,
        maxRadius=14
    )

    count = 0 if found is None else len(found[0])

    if count != N_QUESTIONS * OPTIONS:
        raise ValueError(
            f"Found {count} circles instead of 50. "
            "Check that the entire answer grid is visible and clear."
        )

    circles = sorted(
        found[0].tolist(),
        key=lambda c: c[0]
    )

    columns = [
        circles[:25],
        circles[25:]
    ]

    if max(c[0] for c in columns[0]) >= min(c[0] for c in columns[1]):
        raise ValueError(
            "Unable to separate the two answer columns."
        )

    rows = []

    for column in columns:

        column.sort(key=lambda c: c[1])

        for j in range(0, 25, OPTIONS):

            row = sorted(
                column[j:j + OPTIONS],
                key=lambda c: c[0]
            )

            if len(row) != OPTIONS:
                raise ValueError(
                    "Missing bubbles in a question row."
                )

            ys = [c[1] for c in row]
            gaps = np.diff([c[0] for c in row])

            if max(ys) - min(ys) > 13:
                raise ValueError(
                    "Bubbles in a question are not horizontally aligned."
                )

            if np.any(gaps < 20) or np.any(gaps > 40):
                raise ValueError(
                    "Unexpected spacing between A-E bubbles."
                )

            rows.append(row)

    # Check that each column has five distinct rows.
    for offset in (0, 5):

        centers = [
            float(np.median([c[1] for c in row]))
            for row in rows[offset:offset + 5]
        ]

        row_gaps = np.diff(centers)

        if np.any(row_gaps < 55) or np.any(row_gaps > 95):
            raise ValueError(
                "Unexpected spacing between question rows."
            )

    # Check that left and right columns line up.
    for i in range(5):

        left_y = np.median([c[1] for c in rows[i]])
        right_y = np.median([c[1] for c in rows[i + 5]])

        if abs(left_y - right_y) > 15:
            raise ValueError(
                "Question rows across columns do not line up."
            )

    return rows


# --------------------------------------------------
# BUBBLE MEASUREMENT
# --------------------------------------------------

def measure(gray, circle):
    """
    Measure central shading while excluding
    the outer printed bubble ring.
    """

    x, y, _ = (
        int(round(value))
        for value in circle
    )

    radius = 7

    patch = gray[
        y-radius:y+radius+1,
        x-radius:x+radius+1
    ]

    if patch.shape != (15, 15):
        raise ValueError(
            "Bubble too close to photo edge."
        )

    yy, xx = np.ogrid[
        -radius:radius+1,
        -radius:radius+1
    ]

    pixels = patch[
        xx * xx + yy * yy < 40
    ]

    return (
        float(np.std(pixels)),
        float(np.median(pixels))
    )


# --------------------------------------------------
# ANSWER CLASSIFICATION
# --------------------------------------------------

def classify_question(stats):
    """
    Return:
    answer,
    strongly marked indices,
    possible second-mark indices.
    """

    stds = [s for s, _ in stats]
    medians = [m for _, m in stats]

    baseline = float(np.median(medians))

    # Detect strong pencil shading.
    strong = []

    for i in range(OPTIONS):

        others = [
            medians[j]
            for j in range(OPTIONS)
            if j != i
        ]

        if (
            stds[i] < MAX_SHADED_STD
            and np.median(others) - medians[i]
            >= MIN_DARKER_THAN_OTHERS
        ):
            strong.append(i)

    # Detect possible second marks.
    possible = [
        i for i in range(OPTIONS)
        if i not in strong
        and stds[i] < SECOND_MARK_STD
        and baseline - medians[i] >= SECOND_MARK_DARKNESS
    ]

    if len(strong) >= 2:

        answer = "MULTIPLE"

    elif len(strong) == 1:

        answer = "REVIEW" if possible else LETTERS[strong[0]]

    elif len(possible) >= 2:

        answer = "REVIEW"

    elif len(possible) == 1:

        answer = "REVIEW"

    else:

        darkest = int(np.argmin(medians))

        others = [
            medians[j]
            for j in range(OPTIONS)
            if j != darkest
        ]

        delta = float(
            np.median(others) - medians[darkest]
        )

        answer = (
            "REVIEW"
            if delta >= REVIEW_DARKNESS
            and stds[darkest] < REVIEW_STD
            else "BLANK"
        )

    return answer, strong, possible


# --------------------------------------------------
# MAIN DETECTION FUNCTION
# --------------------------------------------------

def detect_answers(path, debug_path="debug_output_photo.png"):

    img = cv2.imread(str(path))

    if img is None:
        raise ValueError(
            f"Could not open image: {path}"
        )

    # STEP 1: Straighten the paper.
    img = correct_perspective(img)

    # STEP 2: Resize the corrected paper.
    height = round(
        img.shape[0] * WORK_WIDTH / img.shape[1]
    )

    img = cv2.resize(
        img,
        (WORK_WIDTH, height),
        interpolation=cv2.INTER_AREA
    )

    # STEP 3: Convert to grayscale.
    gray = cv2.cvtColor(
        img,
        cv2.COLOR_BGR2GRAY
    )

    # STEP 4: Find the answer bubbles.
    rows = find_grid(gray)

    annotated = img.copy()

    answers = []

    print("Question | Answer   | Std deviations      | Medians")
    print("-" * 76)

    # STEP 5: Read each question.
    for q, row in enumerate(rows, start=1):

        stats = [
            measure(gray, circle)
            for circle in row
        ]

        answer, strong, possible = classify_question(stats)

        answers.append(answer)

        # Draw detection results.
        for i, (x, y, _) in enumerate(row):

            # Green = clear mark
            # Orange = possible mark
            # Blue = unmarked

            color = (
                (0, 190, 0) if i in strong
                else (0, 165, 255) if i in possible
                else (255, 0, 0)
            )

            cv2.circle(
                annotated,
                (round(x), round(y)),
                13,
                color,
                2
            )

        x, y, _ = row[0]

        cv2.putText(
            annotated,
            f"{q}:{answer}",
            (max(0, int(x) - 55), max(12, int(y) - 16)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.34,
            (0, 0, 210),
            1
        )

        stds = [
            round(s)
            for s, _ in stats
        ]

        medians = [
            round(m)
            for _, m in stats
        ]

        print(
            f"Q{q:02d}      | {answer:<8} | "
            f"{str(stds):<19} | {medians}"
        )

    # STEP 6: Save debug image.
    if not cv2.imwrite(str(debug_path), annotated):
        raise ValueError(
            f"Could not save debug image: {debug_path}"
        )

    print("\nANSWERS:", answers)
    print("Debug image:", debug_path)

    return answers


# --------------------------------------------------
# MANUAL ANSWER CORRECTIONS
# --------------------------------------------------

def apply_corrections(answers, entries, label):
    """
    Manually review/correct a sheet.
    Example: --set 3=B
    """

    updated = answers.copy()
    used = set()

    for entry in entries:

        try:
            question_text, answer = entry.split("=", 1)
            question = int(question_text)

        except ValueError as exc:
            raise ValueError(
                f"Invalid {label} correction '{entry}'; use 3=B."
            ) from exc

        answer = answer.strip().upper()

        if question not in range(1, N_QUESTIONS + 1) or question in used:
            raise ValueError(
                f"Invalid or repeated question number: {question}"
            )

        allowed = (
            set(LETTERS)
            if label == "key"
            else set(LETTERS) | {"BLANK", "MULTIPLE"}
        )

        if answer not in allowed:
            raise ValueError(
                f"Invalid {label} answer '{answer}'. "
                f"Allowed: {sorted(allowed)}"
            )

        used.add(question)
        updated[question - 1] = answer

        print(
            f"Manual correction ({label}): "
            f"Q{question} = {answer}"
        )

    return updated


# --------------------------------------------------
# COMMAND-LINE TESTING
# --------------------------------------------------

def main():

    parser = argparse.ArgumentParser(
        description=__doc__
    )

    parser.add_argument(
        "photo",
        help="Photo of the student Scantron"
    )

    parser.add_argument(
        "--key",
        help="Photo of teacher answer key"
    )

    parser.add_argument(
        "--student-id",
        default="test-student"
    )

    parser.add_argument(
        "--csv",
        default="results.csv"
    )

    parser.add_argument(
        "--set",
        action="append",
        default=[],
        metavar="Q=ANSWER",
        help="Correct a student's detected answer"
    )

    parser.add_argument(
        "--key-set",
        action="append",
        default=[],
        metavar="Q=ANSWER",
        help="Correct a teacher key's detected answer"
    )

    args = parser.parse_args()

    try:

        if args.key_set and not args.key:
            raise ValueError(
                "--key-set requires --key"
            )

        student = detect_answers(args.photo)

        student = apply_corrections(
            student,
            args.set,
            "student"
        )

        if not args.key:

            if args.set:
                print("Corrected answers:", student)

            return

        key = detect_answers(
            args.key,
            "debug_key_photo.png"
        )

        key = apply_corrections(
            key,
            args.key_set,
            "key"
        )

        if any(answer not in LETTERS for answer in key):
            raise ValueError(
                "Teacher key has BLANK/MULTIPLE/REVIEW; "
                "correct with --key-set Q=A"
            )

        if "REVIEW" in student:

            questions = [
                str(i)
                for i, answer in enumerate(student, 1)
                if answer == "REVIEW"
            ]

            raise ValueError(
                "Student answer(s) need manual review: Q"
                + ", Q".join(questions)
                + ". Correct with --set Q=A or --set Q=BLANK"
            )

        correct = sum(
            s == k
            for s, k in zip(student, key)
        )

        percent = correct * 100 / N_QUESTIONS

        print(
            f"\nGrade: {correct}/{N_QUESTIONS} "
            f"({percent:.0f}%)"
        )

        output = Path(args.csv)
        output.parent.mkdir(
            parents=True,
            exist_ok=True
        )

        with output.open(
            "a",
            newline="",
            encoding="utf-8"
        ) as file:

            writer = csv.writer(file)

            if file.tell() == 0:
                writer.writerow([
                    "Student ID",
                    *[f"Q{i}" for i in range(1, 11)],
                    "Correct",
                    "Percent"
                ])

            student_id = str(args.student_id)

            # Prevent spreadsheet formula interpretation.
            if student_id.startswith(
                ("=", "+", "-", "@", "\t", "\r")
            ):
                student_id = "'" + student_id

            writer.writerow([
                student_id,
                *student,
                correct,
                percent
            ])

        print("Saved:", output)

    except (ValueError, OSError, cv2.error) as exc:

        parser.exit(
            1,
            f"ERROR: {exc}\n"
        )


if __name__ == "__main__":
    main()
